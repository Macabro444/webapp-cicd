{
  "name": "webapp-contenedor",
  "version": "1.0.0",
  "description": "API REST de productos con SQLite, socket TCP y pipeline CI/CD (GitHub Actions + Docker Hub + AWS EC2)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --verbose --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "app.js",
      "db.js",
      "socket.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  }
}
